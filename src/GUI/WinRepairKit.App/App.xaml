<Application x:Class="WinRepairKit.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinRepairKit.App.ViewModels"
             xmlns:views="clr-namespace:WinRepairKit.App.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Themes/ThemeFluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- Global Typography & Base Styles -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI, Inter, Consolas, Arial" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="Segoe UI, Inter, Consolas, Arial" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ViewModel to View Mappings -->
            <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
                <views:OverviewView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ScanningViewModel}">
                <views:ScanningView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:IssueDetailViewModel}">
                <views:IssueDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RepairPlanViewModel}">
                <views:RepairPlanView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RepairResultViewModel}">
                <views:RepairResultView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                <views:HistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
