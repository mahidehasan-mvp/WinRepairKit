<UserControl x:Class="WinRepairKit.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinRepairKit.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:AboutViewModel}"
             d:DesignHeight="950" d:DesignWidth="920">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel MaxWidth="850" HorizontalAlignment="Left">

            <!-- Title Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Settings &amp; System Preferences" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" Margin="0,0,0,4" />
                <TextBlock Text="Configure execution safeguards, maintenance policies, appearance, and diagnostic support." FontSize="13" Foreground="{DynamicResource BrushOnSurfaceVariant}" />
            </StackPanel>

            <!-- Status Feedback Toast (if any) -->
            <Border Visibility="{Binding HasSettingsStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{DynamicResource BrushSurfaceLow}" BorderBrush="{DynamicResource BrushPrimary}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,20">
                <TextBlock Text="{Binding SettingsStatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}" />
            </Border>

            <!-- 1. Safety & Execution Rules Card -->
            <Border Background="{DynamicResource BrushSurfaceLowest}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" FontSize="18" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Safety &amp; Execution Safeguards" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Always Dry Run Checkbox -->
                    <CheckBox IsChecked="{Binding AlwaysDryRunFirst}" Margin="0,0,0,14">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Require dry-run simulation first (Recommended)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" />
                            <TextBlock Text="Simulates operations with zero mutations before executing destructive repairs." FontSize="12" Foreground="{DynamicResource BrushOnSurfaceVariant}" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <!-- Auto-Scan on Startup -->
                    <CheckBox IsChecked="{Binding AutoScanOnStartup}" Margin="0,0,0,14">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Auto-scan system on application startup" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" />
                            <TextBlock Text="Automatically scans for corrupted containers and temporary build-up when opened." FontSize="12" Foreground="{DynamicResource BrushOnSurfaceVariant}" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <!-- Privilege & Elevation Status -->
                    <Border Background="{DynamicResource BrushSurfaceLow}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Current Elevation Mode" FontSize="12" Foreground="{DynamicResource BrushOutline}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding ElevationStatusText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding RestartElevatedCommand}" 
                                    Content="Restart as Administrator" 
                                    Background="{DynamicResource BrushPrimary}" 
                                    Foreground="{DynamicResource BrushPrimaryForeground}" 
                                    FontSize="12" FontWeight="Bold" 
                                    Padding="14,6" Height="32" BorderThickness="0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. Appearance & Visual HUD Card -->
            <Border Background="{DynamicResource BrushSurfaceLowest}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="&#xE771;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" FontSize="18" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Appearance &amp; HUD Styling" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Theme Selector Row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Application Visual Theme" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" />
                            <TextBlock Text="Select between Windows Fluent Precision and Cyberpunk 2077 Night City HUD." FontSize="12" Foreground="{DynamicResource BrushOnSurfaceVariant}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}" 
                                  Height="32" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                  Background="{DynamicResource BrushComboBg}" Foreground="{DynamicResource BrushComboText}" BorderBrush="{DynamicResource BrushComboBorder}" />
                    </Grid>

                    <!-- Motion Animations Toggle -->
                    <CheckBox IsChecked="{Binding EnableAnimations}">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Enable animated scanning radar &amp; motion sweeps" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" />
                            <TextBlock Text="Plays fluid visual indicators during active diagnostic checks." FontSize="12" Foreground="{DynamicResource BrushOnSurfaceVariant}" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- 3. Maintenance & Storage Policies Card -->
            <Border Background="{DynamicResource BrushSurfaceLowest}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" FontSize="18" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Maintenance &amp; Storage Policies" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Temp File Threshold -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Temporary Files Inactive Age" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" />
                            <TextBlock Text="Threshold for identifying safe purgeable user cache and crash dumps." FontSize="12" Foreground="{DynamicResource BrushOnSurfaceVariant}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding TempFileAgeOptions}" SelectedItem="{Binding SelectedTempFilesAge}" 
                                  Height="32" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                  Background="{DynamicResource BrushComboBg}" Foreground="{DynamicResource BrushComboText}" BorderBrush="{DynamicResource BrushComboBorder}" />
                    </Grid>

                    <!-- Audit Log Retention -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Transaction Journal Retention" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" />
                            <TextBlock Text="Retention policy for persistent repair history logs." FontSize="12" Foreground="{DynamicResource BrushOnSurfaceVariant}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding LogRetentionOptions}" SelectedItem="{Binding SelectedLogRetention}" 
                                  Height="32" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                  Background="{DynamicResource BrushComboBg}" Foreground="{DynamicResource BrushComboText}" BorderBrush="{DynamicResource BrushComboBorder}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Diagnostics, Logs & Troubleshooting Card -->
            <Border Background="{DynamicResource BrushSurfaceLowest}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="&#xEC59;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" FontSize="18" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Diagnostics &amp; Troubleshooting" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Export redacted diagnostic packages or inspect local state snapshot journals." FontSize="12" Foreground="{DynamicResource BrushOnSurfaceVariant}" Margin="0,0,0,16" />

                    <!-- Action Buttons Row -->
                    <WrapPanel Margin="0,0,0,12">
                        <Button Command="{Binding GenerateSupportBundleCommand}" 
                                Background="{DynamicResource BrushPrimary}" 
                                Foreground="{DynamicResource BrushPrimaryForeground}" 
                                FontSize="13" FontWeight="Bold" 
                                Padding="16,8" Height="36" BorderThickness="0" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA35;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Export Sanitized Support Bundle" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenLogDirectoryCommand}" 
                                Content="Open Logs Directory" 
                                Background="{DynamicResource BrushSurfaceLow}" 
                                BorderBrush="{DynamicResource BrushOutlineVariant}" 
                                BorderThickness="1" 
                                Foreground="{DynamicResource BrushOnSurface}" 
                                FontSize="13" FontWeight="SemiBold" 
                                Padding="14,8" Height="36" Margin="0,0,10,10" />

                        <Button Command="{Binding OpenSnapshotsDirectoryCommand}" 
                                Content="Open Snapshots Folder" 
                                Background="{DynamicResource BrushSurfaceLow}" 
                                BorderBrush="{DynamicResource BrushOutlineVariant}" 
                                BorderThickness="1" 
                                Foreground="{DynamicResource BrushOnSurface}" 
                                FontSize="13" FontWeight="SemiBold" 
                                Padding="14,8" Height="36" Margin="0,0,10,10" />

                        <Button Command="{Binding ClearAuditCacheCommand}" 
                                Content="Clear Audit Cache" 
                                Background="Transparent" 
                                BorderBrush="{DynamicResource BrushOutlineVariant}" 
                                BorderThickness="1" 
                                Foreground="{DynamicResource BrushTertiary}" 
                                FontSize="13" FontWeight="SemiBold" 
                                Padding="14,8" Height="36" Margin="0,0,10,10" />
                    </WrapPanel>

                    <TextBlock Text="{Binding SupportBundleStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 5. System Environment & MIT License Card -->
            <Border Background="{DynamicResource BrushSurfaceLowest}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="System Environment &amp; Legal" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Version:" FontSize="12" Foreground="{DynamicResource BrushOutline}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VersionText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Operating System:" FontSize="12" Foreground="{DynamicResource BrushOutline}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OsVersionText}" FontSize="12" Foreground="{DynamicResource BrushOnSurface}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Runtime:" FontSize="12" Foreground="{DynamicResource BrushOutline}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DotNetRuntimeText}" FontSize="12" Foreground="{DynamicResource BrushOnSurface}" Margin="0,0,0,6" />
                    </Grid>

                    <Button Command="{Binding ViewLicenseCommand}" 
                            Content="View MIT Open Source License" 
                            Background="Transparent" 
                            BorderBrush="{DynamicResource BrushOutlineVariant}" 
                            BorderThickness="1" 
                            Foreground="{DynamicResource BrushPrimary}" 
                            FontSize="12" FontWeight="SemiBold" 
                            Padding="14,6" Height="32" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
