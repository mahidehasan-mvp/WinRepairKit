<UserControl x:Class="WinRepairKit.App.Views.RepairPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinRepairKit.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:RepairPlanViewModel}"
             d:DesignHeight="850" d:DesignWidth="1050">

    <UserControl.Resources>
        <!-- Primary Action Repair Button with Explicit Disabled State and Dynamic Foreground -->
        <Style x:Key="RepairActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryForeground}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Height" Value="38" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#79A7D0" />
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Dry Run Button Style -->
        <Style x:Key="DryRunButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceLowest}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushOutlineVariant}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource BrushOnSurface}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushSurfaceHigh}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Title & Description Header -->
            <StackPanel Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource BrushSurfaceLow}" BorderBrush="{DynamicResource BrushTertiary}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" 
                                   FontSize="16" Foreground="{DynamicResource BrushTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding PlanTitle}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding PlanDescription}" FontSize="13" Foreground="{DynamicResource BrushOnSurfaceVariant}" TextWrapping="Wrap" LineHeight="20" MaxWidth="850" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Main 2-Column Plan Canvas matching UI UX Mockup -->
            <Border Background="{DynamicResource BrushSurfaceLowest}" 
                    BorderBrush="{DynamicResource BrushBorder}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Steps Timeline -->
                    <Border Grid.Column="0" Padding="28">
                        <StackPanel>
                            <TextBlock Text="Execution Plan" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" Margin="0,0,0,20" />

                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" 
                                                Padding="0,0,0,16" 
                                                Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Step Number Icon Circle -->
                                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" 
                                                        Background="{DynamicResource BrushSurfaceLow}" 
                                                        BorderBrush="{DynamicResource BrushBorder}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Top" Margin="0,1,0,0">
                                                    <TextBlock Text="{Binding StepIconGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" 
                                                               FontSize="12" FontWeight="Bold" 
                                                               Foreground="{DynamicResource BrushPrimary}" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Step Content -->
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding StepDisplayTitle}" FontSize="14" FontWeight="SemiBold" 
                                                                   Foreground="{DynamicResource BrushOnSurface}" Margin="0,0,8,0" />
                                                        
                                                        <Border Background="{DynamicResource BrushSurfaceLow}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RiskLevelName}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryContainer}" />
                                                        </Border>
                                                    </StackPanel>
                                                    
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource BrushOnSurfaceVariant}" TextWrapping="Wrap" LineHeight="18" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>

                    <!-- Right Column: Risk Assessment & Actions -->
                    <Border Grid.Column="1" Background="{DynamicResource BrushSurfaceLow}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1,0,0,0" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Risk Assessment" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" Margin="0,0,0,16" />

                                <!-- Risk Warning Box -->
                                <Border Background="{DynamicResource BrushSurfaceLowest}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,20">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" 
                                                       FontSize="14" Foreground="{DynamicResource BrushTertiary}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Moderate Risk" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushOnSurface}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding RiskAssessmentText}" FontSize="12" Foreground="{DynamicResource BrushOnSurfaceVariant}" TextWrapping="Wrap" LineHeight="18" />
                                    </StackPanel>
                                </Border>

                                <!-- Consent Checkbox -->
                                <CheckBox IsChecked="{Binding IsRiskAcknowledged}" Margin="0,0,0,20">
                                    <TextBlock Text="{Binding ExplicitDisclaimerText}" 
                                               FontSize="12" Foreground="{DynamicResource BrushOnSurfaceVariant}" TextWrapping="Wrap" LineHeight="16" />
                                </CheckBox>
                            </StackPanel>

                            <!-- Buttons Section -->
                            <StackPanel Grid.Row="1">
                                <!-- Preview with Dry Run Button (with Vector Flask Icon) -->
                                <Button Command="{Binding PreviewDryRunCommand}" 
                                        Style="{StaticResource DryRunButtonStyle}"
                                        Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Vector Flask Icon -->
                                        <Path Width="14" Height="14" Stretch="Uniform" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                              Margin="0,0,8,0" VerticalAlignment="Center"
                                              Data="M 6,1 L 8,1 L 8,4.5 L 2.5,13 C 2,13.8 2.5,15 3.5,15 L 10.5,15 C 11.5,15 12,13.8 11.5,13 L 6,4.5 L 6,1 Z M 6,9 L 8,9 L 9.8,12 L 4.2,12 Z" />
                                        <TextBlock Text="Preview with Dry Run" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Cancel and Repair Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Command="{Binding CancelCommand}" 
                                            Content="Cancel" 
                                            Background="{DynamicResource BrushSurfaceLowest}" 
                                            BorderBrush="{DynamicResource BrushOutlineVariant}" 
                                            BorderThickness="1" 
                                            Foreground="{DynamicResource BrushOnSurfaceVariant}" 
                                            FontSize="13" FontWeight="SemiBold" 
                                            Padding="12,8" 
                                            Height="38"
                                            Margin="0,0,6,0" />

                                    <!-- Repair Button with Vector Wrench Icon and Dynamic IsEnabled Binding -->
                                    <Button Grid.Column="1" 
                                            Command="{Binding ExecuteRepairCommand}" 
                                            IsEnabled="{Binding IsRiskAcknowledged}" 
                                            Style="{StaticResource RepairActionButtonStyle}"
                                            Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- Vector Wrench Icon -->
                                            <Path Width="13" Height="13" Stretch="Uniform" 
                                                  Fill="{DynamicResource BrushPrimaryForeground}" 
                                                  Margin="0,0,6,0" VerticalAlignment="Center"
                                                  Data="M 12.7,2.3 C 11.3,0.9 9.2,0.6 7.5,1.5 L 10,4 L 8.5,5.5 L 6,3 C 5.1,4.7 5.4,6.8 6.8,8.2 C 7.9,9.3 9.4,9.7 10.8,9.4 L 15.4,14 C 15.8,14.4 16.4,14.4 16.8,14 C 17.2,13.6 17.2,13 16.8,12.6 L 12.2,8 C 12.5,6.6 12.1,5.1 11,4 Z M 1,16 L 4,13 L 3,12 L 0,15 C -0.3,15.3 -0.3,15.7 0,16 C 0.3,16.3 0.7,16.3 1,16 Z" />
                                            <TextBlock Text="Repair" Foreground="{DynamicResource BrushPrimaryForeground}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Execution Terminal Log Output -->
            <Border Background="{DynamicResource BrushSurfaceHigh}" 
                    BorderBrush="{DynamicResource BrushBorder}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Execution Output Log" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" Margin="0,0,0,8" />
                    <TextBox Text="{Binding TerminalOutput}" 
                             FontFamily="Consolas, JetBrains Mono" 
                             FontSize="12" 
                             Foreground="{DynamicResource BrushOnSurfaceVariant}" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             IsReadOnly="True" 
                             MinHeight="100" 
                             MaxHeight="250" 
                             VerticalScrollBarVisibility="Auto" 
                             TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
