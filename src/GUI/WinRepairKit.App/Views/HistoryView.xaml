<UserControl x:Class="WinRepairKit.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinRepairKit.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:HistoryViewModel}"
             d:DesignHeight="800" d:DesignWidth="920">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Title & Header Bar -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Repair History &amp; Audit Log" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" Margin="0,0,0,4" />
                    <TextBlock Text="Review the persistent transaction journal of all previous scans, dry-runs, and repair operations." FontSize="13" Foreground="{DynamicResource BrushOnSurfaceVariant}" />
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding RefreshHistoryCommand}" 
                        Background="{DynamicResource BrushSurfaceLowest}" 
                        BorderBrush="{DynamicResource BrushOutlineVariant}" 
                        BorderThickness="1" 
                        Foreground="{DynamicResource BrushOnSurface}" 
                        FontSize="13" FontWeight="SemiBold" 
                        Padding="16,8" Height="36" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Transactions Table Card -->
            <Border Background="{DynamicResource BrushSurfaceLowest}" 
                    BorderBrush="{DynamicResource BrushBorder}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Margin="0,0,0,24">
                <StackPanel>

                    <!-- Table Header -->
                    <Border Background="{DynamicResource BrushSurfaceLow}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="0,0,0,1" 
                            CornerRadius="8,8,0,0" 
                            Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="DATE &amp; TIME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushOutline}" />
                            <TextBlock Grid.Column="1" Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushOutline}" />
                            <TextBlock Grid.Column="2" Text="MODULE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushOutline}" />
                            <TextBlock Grid.Column="3" Text="MODE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushOutline}" />
                            <TextBlock Grid.Column="4" Text="DETAILS &amp; OUTCOME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushOutline}" />
                        </Grid>
                    </Border>

                    <!-- History Items List -->
                    <ItemsControl ItemsSource="{Binding HistoryItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding TimestampText}" FontSize="12" FontFamily="Consolas, JetBrains Mono" Foreground="{DynamicResource BrushOnSurfaceVariant}" VerticalAlignment="Center" />

                                        <Border Grid.Column="1" Background="{DynamicResource BrushSurfaceLow}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusBadgeColor}" />
                                        </Border>

                                        <TextBlock Grid.Column="2" Text="{Binding ModuleName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="3" Text="{Binding ModeText}" FontSize="12" Foreground="{DynamicResource BrushOnSurfaceVariant}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="4" Text="{Binding DetailsText}" FontSize="12" Foreground="{DynamicResource BrushOnSurfaceVariant}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
