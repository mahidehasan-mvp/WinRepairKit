<UserControl x:Class="WinRepairKit.App.Views.RepairResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinRepairKit.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:RepairResultViewModel}"
             d:DesignHeight="850" d:DesignWidth="950">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">

            <!-- Result Hero Card -->
            <Border Background="{StaticResource BrushSurfaceLowest}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" 
                            Background="{StaticResource BrushSecondaryContainer}" 
                            Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" 
                                   FontSize="28" Foreground="{StaticResource BrushSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding StatusHeading}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BrushOnSurface}" Margin="0,0,12,0" />
                            <Border Background="{StaticResource BrushSecondaryContainer}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ResultStatusBadge}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushSecondary}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusSubheading}" FontSize="14" Foreground="{StaticResource BrushOnSurfaceVariant}" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding RepairId, StringFormat='Repair Session ID: {0}'}" FontSize="12" FontFamily="Consolas, JetBrains Mono" Foreground="{StaticResource BrushOutline}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Before vs. After Comparison Matrix -->
            <Border Background="{StaticResource BrushSurfaceLowest}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Verification Diff (Before vs. After)" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushOnSurface}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Before Column -->
                        <Border Grid.Column="0" Background="{StaticResource BrushSurfaceLow}" CornerRadius="6" Padding="16">
                            <StackPanel>
                                <TextBlock Text="BEFORE REPAIR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushOutline}" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding BeforeProblems, StringFormat='Problems Found: {0}'}" FontSize="13" Foreground="{StaticResource BrushOnSurface}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding BeforeItems, StringFormat='Affected Items: {0}'}" FontSize="13" Foreground="{StaticResource BrushOnSurface}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding BeforeSize, StringFormat='Total Size: {0}'}" FontSize="13" Foreground="{StaticResource BrushOnSurface}" />
                            </StackPanel>
                        </Border>

                        <!-- Arrow -->
                        <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" 
                                   FontSize="20" Foreground="{StaticResource BrushOutline}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- After Column -->
                        <Border Grid.Column="2" Background="{StaticResource BrushSecondaryContainer}" CornerRadius="6" Padding="16">
                            <StackPanel>
                                <TextBlock Text="AFTER VERIFICATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushSecondary}" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding AfterProblems, StringFormat='Remaining Problems: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushOnSurface}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding AfterStatus, StringFormat='Health Status: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushSecondary}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- What Changed Narrative Card -->
            <Border Background="{StaticResource BrushSurfaceLowest}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Summary of Changes" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushOnSurface}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding WhatChangedText}" FontSize="13" Foreground="{StaticResource BrushOnSurfaceVariant}" LineHeight="20" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Navigation CTAs -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Command="{Binding BackToOverviewCommand}" 
                        Content="Back to Overview" 
                        Background="{StaticResource BrushPrimary}" 
                        Foreground="White" 
                        FontSize="13" FontWeight="SemiBold" 
                        Padding="20,10" 
                        Height="40"
                        BorderThickness="0" 
                        Margin="0,0,12,0" />

                <Button Command="{Binding ScanAgainCommand}" 
                        Content="Scan Again" 
                        Background="{StaticResource BrushSurfaceLow}" 
                        BorderBrush="{StaticResource BrushOutlineVariant}" 
                        BorderThickness="1" 
                        Foreground="{StaticResource BrushOnSurface}" 
                        FontSize="13" FontWeight="SemiBold" 
                        Padding="20,10" 
                        Height="40" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
