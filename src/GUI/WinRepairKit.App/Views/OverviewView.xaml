<UserControl x:Class="WinRepairKit.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinRepairKit.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:OverviewViewModel}"
             d:DesignHeight="800" d:DesignWidth="920">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- PC Status Hero Card -->
            <Border Background="{DynamicResource BrushSurfaceLowest}" 
                    BorderBrush="{DynamicResource BrushBorder}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="24" 
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status Icon -->
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" 
                            Background="{DynamicResource BrushTertiaryContainer}" 
                            Margin="0,0,20,0" 
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" 
                                   FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Status Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OverallStatusTitle}" 
                                    FontSize="20" FontWeight="SemiBold" 
                                    Foreground="{DynamicResource BrushOnSurface}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding OverallStatusDescription}" 
                                    FontSize="14" 
                                    Foreground="{DynamicResource BrushOnSurfaceVariant}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding LastScanTimeText}" 
                                    FontSize="12" 
                                    Foreground="{DynamicResource BrushOutline}" />
                    </StackPanel>

                    <!-- Scan Button with High-Contrast Primary Foreground -->
                    <Button Grid.Column="2" 
                            Command="{Binding StartScanCommand}"
                            Background="{DynamicResource BrushPrimary}" 
                            Foreground="{DynamicResource BrushPrimaryForeground}" 
                            FontSize="13" FontWeight="Bold" 
                            Padding="20,10" 
                            Height="40"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" 
                                       Foreground="{DynamicResource BrushPrimaryForeground}"
                                       FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Scan My PC" Foreground="{DynamicResource BrushPrimaryForeground}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Module Health Cards 2-Column Grid -->
            <ItemsControl ItemsSource="{Binding ModuleCards}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding OpenModuleCommand}" 
                                Background="{DynamicResource BrushSurfaceLowest}" 
                                BorderBrush="{DynamicResource BrushBorder}" 
                                BorderThickness="1" 
                                Padding="20" 
                                Margin="0,0,12,0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" 
                                               FontSize="22" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ModuleName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource BrushPrimaryContainer}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" 
                                               FontSize="14" Foreground="{DynamicResource BrushOutline}" VerticalAlignment="Center" />
                                </Grid>
                                <Separator Background="{DynamicResource BrushBorder}" Margin="0,0,0,12" />
                                <TextBlock Text="{Binding ModuleDescription}" FontSize="13" Foreground="{DynamicResource BrushOnSurfaceVariant}" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Recommended Actions Section -->
            <Border Background="{DynamicResource BrushSurfaceLowest}" 
                    BorderBrush="{DynamicResource BrushBorder}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Margin="0,0,0,24">
                <StackPanel>
                    <Border Background="{DynamicResource BrushSurfaceLow}" 
                            Padding="20,12" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="0,0,0,1" 
                            CornerRadius="8,8,0,0">
                        <TextBlock Text="Recommended Actions" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSurface}" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding RecommendedActions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="20,16" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,16,0" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{DynamicResource BrushOnSurface}" FontWeight="Normal" />
                                            <TextBlock Text="{Binding Path}" FontSize="12" FontFamily="Consolas, JetBrains Mono" Foreground="{DynamicResource BrushOutline}" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <Button Grid.Column="2" 
                                                Command="{Binding ReviewActionCommand}" 
                                                Content="{Binding ActionButtonText}" 
                                                Background="Transparent" 
                                                BorderBrush="{DynamicResource BrushOutlineVariant}" 
                                                BorderThickness="1" 
                                                Foreground="{DynamicResource BrushOnSurface}" 
                                                FontSize="13" FontWeight="SemiBold" 
                                                Padding="16,6" 
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
