<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fluent Precision Palette -->
    <Color x:Key="PrimaryColor">#005FAA</Color>
    <Color x:Key="PrimaryContainerColor">#0078D4</Color>
    <Color x:Key="SecondaryColor">#006E06</Color>
    <Color x:Key="SecondaryContainerColor">#91F77E</Color>
    <Color x:Key="TertiaryColor">#AF2E00</Color>
    <Color x:Key="TertiaryContainerColor">#DA3C03</Color>
    <Color x:Key="ErrorColor">#BA1A1A</Color>
    <Color x:Key="ErrorContainerColor">#FFDAD6</Color>

    <Color x:Key="SurfaceColor">#F9F9F9</Color>
    <Color x:Key="SurfaceLowestColor">#FFFFFF</Color>
    <Color x:Key="SurfaceLowColor">#F3F3F3</Color>
    <Color x:Key="SurfaceContainerColor">#EEEEEE</Color>
    <Color x:Key="SurfaceHighColor">#E8E8E8</Color>
    
    <Color x:Key="OnSurfaceColor">#1A1C1C</Color>
    <Color x:Key="OnSurfaceVariantColor">#404752</Color>
    <Color x:Key="OutlineColor">#717783</Color>
    <Color x:Key="OutlineVariantColor">#C0C7D4</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="BrushPrimaryContainer" Color="{StaticResource PrimaryContainerColor}" />
    <SolidColorBrush x:Key="BrushSecondary" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="BrushSecondaryContainer" Color="{StaticResource SecondaryContainerColor}" />
    <SolidColorBrush x:Key="BrushTertiary" Color="{StaticResource TertiaryColor}" />
    <SolidColorBrush x:Key="BrushTertiaryContainer" Color="{StaticResource TertiaryContainerColor}" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="BrushErrorContainer" Color="{StaticResource ErrorContainerColor}" />

    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BrushSurfaceLowest" Color="{StaticResource SurfaceLowestColor}" />
    <SolidColorBrush x:Key="BrushSurfaceLow" Color="{StaticResource SurfaceLowColor}" />
    <SolidColorBrush x:Key="BrushSurfaceContainer" Color="{StaticResource SurfaceContainerColor}" />
    <SolidColorBrush x:Key="BrushSurfaceHigh" Color="{StaticResource SurfaceHighColor}" />

    <SolidColorBrush x:Key="BrushOnSurface" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="BrushOnSurfaceVariant" Color="{StaticResource OnSurfaceVariantColor}" />
    <SolidColorBrush x:Key="BrushOutline" Color="{StaticResource OutlineColor}" />
    <SolidColorBrush x:Key="BrushOutlineVariant" Color="{StaticResource OutlineVariantColor}" />
    <SolidColorBrush x:Key="BrushBorder" Color="#14000000" /> <!-- 1px border at 8% opacity -->

</ResourceDictionary>
