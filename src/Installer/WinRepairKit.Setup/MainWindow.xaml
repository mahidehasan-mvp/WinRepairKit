<Window x:Class="WinRepairKit.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WinRepairKit Setup" 
        Height="540" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F9F9F9">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="BrushPrimary" Color="#005FAA" />
        <SolidColorBrush x:Key="BrushSurface" Color="#F9F9F9" />
        <SolidColorBrush x:Key="BrushSurfaceLowest" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BrushSurfaceLow" Color="#F3F3F3" />
        <SolidColorBrush x:Key="BrushBorder" Color="#14000000" />
        <SolidColorBrush x:Key="BrushOnSurface" Color="#1A1C1C" />
        <SolidColorBrush x:Key="BrushOnSurfaceVariant" Color="#404752" />
        <SolidColorBrush x:Key="BrushOutline" Color="#717783" />
        <SolidColorBrush x:Key="BrushOutlineVariant" Color="#C0C7D4" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurfaceLowest}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="28,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="WinRepairKit Setup" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}" />
                    <TextBlock Text="Windows 10 &amp; 11 Repair and Maintenance Toolkit" FontSize="12" Foreground="{StaticResource BrushOnSurfaceVariant}" Margin="0,2,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="v0.1.0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushOutline}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main Wizard Content Canvas -->
        <Border Grid.Row="1" Padding="36,28">
            <Grid>

                <!-- Step 1: Welcome -->
                <StackPanel Visibility="{Binding Step1Visibility}">
                    <TextBlock Text="Welcome to WinRepairKit" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BrushOnSurface}" Margin="0,0,0,12" />
                    <TextBlock Text="WinRepairKit is a transparent, safety-first diagnostic and repair toolkit designed to restore and maintain Windows 10 and Windows 11 systems without destructive surprises." 
                               FontSize="14" Foreground="{StaticResource BrushOnSurfaceVariant}" LineHeight="22" TextWrapping="Wrap" Margin="0,0,0,24" />

                    <Border Background="{StaticResource BrushSurfaceLowest}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="What will be installed:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushOnSurface}" Margin="0,0,0,8" />
                            <TextBlock Text="• WinRepairKit Desktop Application (Fluent Precision GUI)" FontSize="12" Foreground="{StaticResource BrushOnSurfaceVariant}" Margin="0,0,0,4" />
                            <TextBlock Text="• Command-Line Tool (winrepair scan, winrepair fix)" FontSize="12" Foreground="{StaticResource BrushOnSurfaceVariant}" Margin="0,0,0,4" />
                            <TextBlock Text="• Pluggable Diagnostic &amp; Repair Engine" FontSize="12" Foreground="{StaticResource BrushOnSurfaceVariant}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Step 2: Options -->
                <StackPanel Visibility="{Binding Step2Visibility}">
                    <TextBlock Text="Installation Options" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushOnSurface}" Margin="0,0,0,16" />

                    <TextBlock Text="Destination Folder:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushOnSurface}" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,20">
                        <TextBox Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="13" Padding="10,8" Height="38" Background="{StaticResource BrushSurfaceLowest}" 
                                 BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1" />
                    </Grid>

                    <TextBlock Text="Additional Shortcuts &amp; Environment:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushOnSurface}" Margin="0,0,0,8" />
                    <CheckBox IsChecked="{Binding AddToPath}" Content="Add WinRepairKit to system PATH (enables 'winrepair' in PowerShell &amp; CMD)" FontSize="13" Margin="0,0,0,8" />
                    <CheckBox IsChecked="{Binding CreateStartMenuShortcut}" Content="Create Start Menu shortcut" FontSize="13" Margin="0,0,0,8" />
                    <CheckBox IsChecked="{Binding CreateDesktopShortcut}" Content="Create Desktop shortcut" FontSize="13" />
                </StackPanel>

                <!-- Step 3: Progress & Error Display -->
                <StackPanel Visibility="{Binding Step3Visibility}" VerticalAlignment="Center">
                    <TextBlock Text="Installing WinRepairKit..." FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushOnSurface}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ProgressStatusText}" FontSize="13" Foreground="{StaticResource BrushOnSurfaceVariant}" Margin="0,0,0,20" />
                    
                    <ProgressBar IsIndeterminate="True" Height="8" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,12" 
                                 Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                    
                    <Border Background="#FFEBEE" BorderBrush="#BA1A1A" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#BA1A1A" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="Please wait while files and system registrations are configured..." FontSize="12" Foreground="{StaticResource BrushOutline}" 
                               Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                </StackPanel>

                <!-- Step 4: Finished -->
                <StackPanel Visibility="{Binding Step4Visibility}">
                    <TextBlock Text="Installation Complete!" FontSize="22" FontWeight="SemiBold" Foreground="#006E06" Margin="0,0,0,12" />
                    <TextBlock Text="WinRepairKit has been successfully installed on your computer." FontSize="14" Foreground="{StaticResource BrushOnSurfaceVariant}" Margin="0,0,0,24" />

                    <Border Background="{StaticResource BrushSurfaceLowest}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Quick Start Commands:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushOnSurface}" Margin="0,0,0,6" />
                            <TextBlock Text="• Run full diagnostic scan : winrepair scan" FontSize="12" FontFamily="Consolas, JetBrains Mono" Foreground="{StaticResource BrushOnSurfaceVariant}" Margin="0,0,0,4" />
                            <TextBlock Text="• Preview dry-run cleanup : winrepair repair TempFiles -DryRun" FontSize="12" FontFamily="Consolas, JetBrains Mono" Foreground="{StaticResource BrushOnSurfaceVariant}" />
                        </StackPanel>
                    </Border>

                    <CheckBox IsChecked="{Binding LaunchOnFinish}" Content="Launch WinRepairKit now" FontSize="13" IsEnabled="True" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- Footer Actions Bar -->
        <Border Grid.Row="2" Background="{StaticResource BrushSurfaceLowest}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="28,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding BackCommand}" 
                            Visibility="{Binding BackButtonVisibility}"
                            Content="Back" 
                            Background="Transparent" 
                            BorderBrush="{StaticResource BrushOutlineVariant}" 
                            BorderThickness="1" 
                            Foreground="{StaticResource BrushOnSurfaceVariant}" 
                            FontSize="13" FontWeight="SemiBold" 
                            Padding="16,8" 
                            Height="36"
                            Margin="0,0,10,0" />

                    <Button Command="{Binding NextCommand}" 
                            Content="{Binding NextButtonText}" 
                            Background="{StaticResource BrushPrimary}" 
                            Foreground="White" 
                            FontSize="13" FontWeight="SemiBold" 
                            Padding="20,8" 
                            Height="36"
                            BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
